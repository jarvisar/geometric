{
  "name": "geometric-web-app",
  "version": "2.0.0",
  "description": "Plotter Geometry: generative geometric line art for pen plotters, with plot-optimized SVG export.",
  "private": true,
  "scripts": {
    "start": "live-server src",
    "prestart": "npm run build:worker",
    "build:worker": "node scripts/build-worker.js",
    "build:pages": "node scripts/build-pages.js",
    "previews": "node scripts/drive.js scripts/previews.steps.js shots/previews 1440 900",
    "check": "node scripts/build-worker.js --check && node scripts/build-pages.js --check && node scripts/check.js && node scripts/check-exports.js",
    "check:pens": "node scripts/check-pens.js",
    "check:alpine": "node scripts/check-alpine.js",
    "check:moonbase": "node scripts/check-moonbase.js",
    "check:examples": "node scripts/check-examples.js",
    "check:state": "node scripts/check-state.js",
    "check:generation": "node scripts/build-worker.js --check && node scripts/check-generation.js",
    "check:edgecases": "node scripts/check-edgecases.js",
    "check:boundaries": "node scripts/check-boundaries.js",
    "check:exports": "node scripts/check-exports.js",
    "smoke:exports": "node scripts/drive.js scripts/exports.steps.js shots/exports",
    "smoke": "node scripts/drive.js scripts/smoke.steps.js shots",
    "smoke:pens": "node scripts/drive.js scripts/pen-colors.steps.js shots",
    "smoke:alpine": "node scripts/drive.js scripts/alpine.steps.js shots/alpine-refactor",
    "smoke:moonbase": "node scripts/drive.js scripts/moonbase.steps.js shots/moonbase 1300 1160",
    "smoke:examples": "node scripts/drive.js scripts/examples.steps.js shots/examples",
    "smoke:state": "node scripts/drive.js scripts/state.steps.js shots/state",
    "smoke:p2": "node scripts/drive.js scripts/p2.steps.js shots/p2",
    "smoke:edgecases": "node scripts/drive.js scripts/edgecases.steps.js shots/edgecases",
    "sheet": "node scripts/shot.js dev/sheet.html \"variants=2&size=220\" shots/sheet.png 1100 6000"
  },
  "devDependencies": {
    "live-server": "^1.2.1"
  },
  "author": "",
  "license": "ISC"
}
